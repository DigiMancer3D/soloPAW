{
  "format": "solopaw-release-manifest-v1",
  "name": "soloPAW Controller Map Studio",
  "version": "0.1.0-rc.1",
  "release_stage": "release-candidate",
  "schema_version": 5,
  "platform_target": "Linux / CachyOS / KDE Plasma / Wayland",
  "desktop_app_id": "solopaw-controller-map-studio",
  "mime_type": "application/x-solopaw-udata",
  "default_project": "defaults/soloPAW_Cyberpunk2077_v2.0_Core.udata",
  "development_files_omitted": [
    "tests/",
    "docs/",
    "ROADMAP.md",
    "run_selftests.sh",
    "assets/g502_reference.png",
    "defaults/*_preview.png",
    "__pycache__/",
    "*.pyc",
    "*.pyo",
    "*.bak",
    "*.tmp"
  ],
  "files": [
    "CHANGELOG.md",
    "README.md",
    "RECOVERY.md",
    "RELEASE_MANIFEST.json",
    "assets/icons/mouse_button.svg",
    "assets/icons/save.svg",
    "assets/icons/shift.svg",
    "assets/icons/wheel.svg",
    "assets/solopaw-controller-map-studio.png",
    "assets/solopaw-controller-map-studio.svg",
    "defaults/soloPAW_Cyberpunk2077_v2.0_Core.udata",
    "desktop/solopaw-controller-map-studio.desktop.in",
    "desktop/solopaw-controller-map-studio.xml",
    "desktop_check.sh",
    "install_desktop.sh",
    "launch.sh",
    "main.py",
    "setup_cachyos.sh",
    "solopaw_studio/__init__.py",
    "solopaw_studio/app.py",
    "solopaw_studio/core.py",
    "uninstall_desktop.sh",
    "verify_release.sh"
  ]
}
